{
  "compilerOptions": {
    // 1. JavaScript output version
    "target": "ES2022",

    // 2. Node.js ES Modules configuration
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // 3. Source aur compiled files ki directories
    "rootDir": "./src",
    "outDir": "./dist",

    // 4. Node.js type definitions
    "types": ["node"],

    // 5. Strict type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // 6. Module aur import handling
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,

    // 7. Build aur debugging options
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,

    // 8. Unresolved side-effect imports par error
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}

