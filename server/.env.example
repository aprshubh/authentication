PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/authentication

ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Comma-separated allowed browser origins (native mobile clients usually omit Origin).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set to 1 behind a single trusted reverse proxy (e.g. Render); keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Resend Mail Service
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Your App <noreply@your-verified-domain.com>

# ImageKit Media Service
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
